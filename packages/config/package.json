{
  "name": "@appcask/config",
  "version": "0.1.0",
  "description": "Config schema, validator, and types for appcask.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./defaults": "./dist/defaults.js",
    "./schema.json": "./schema.json"
  },
  "files": ["dist", "schema.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  }
}
